{
  "datasets": [
    {
      "name": "ds_kpis",
      "displayName": "Executive KPIs",
      "queryLines": [
        "SELECT grant_count, total_awarded, total_expended, total_obligated, execution_rate,",
        "       overrun_count, at_risk_count, under_exec_count, on_track_count,",
        "       avg_monthly_velocity, vendor_data_gaps, vendor_renewals_due, as_of_ts",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_executive_kpis')"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    },
    {
      "name": "ds_execution",
      "displayName": "Financial execution",
      "queryLines": [
        "SELECT grant_id, project_name, onr_code, tech_area, appropriation, award_amount,",
        "       expended, obligated, projected_total, risk_class, trend_id,",
        "       predicted_velocity, months_to_exhaustion",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_financial_execution')"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    },
    {
      "name": "ds_by_code",
      "displayName": "Execution by ONR code",
      "queryLines": [
        "SELECT onr_code, COUNT(*) AS grants, SUM(award_amount) AS awarded, SUM(expended) AS expended,",
        "       SUM(CASE WHEN risk_class = 'OVERRUN' THEN 1 ELSE 0 END) AS overruns",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_financial_execution')",
        "GROUP BY onr_code"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    },
    {
      "name": "ds_vendors",
      "displayName": "Vendor lifecycle",
      "queryLines": [
        "SELECT subscription_id, vendor_name, dataset_name, status, gap_status,",
        "       days_to_renewal, usage_pct, annual_cost, feeds_gold_table",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_vendor_lifecycle')"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    },
    {
      "name": "ds_summary",
      "displayName": "Automated summary",
      "queryLines": [
        "SELECT generated_ts, summary_text, generator",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_executive_summary')"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    },
    {
      "name": "ds_quality",
      "displayName": "Data health scores",
      "queryLines": [
        "SELECT dataset, row_count, null_rate, freshness_hours, health_score, health_band",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_data_quality_scores')"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    },
    {
      "name": "ds_queue",
      "displayName": "Approval queue",
      "queryLines": [
        "SELECT grant_id, anomaly_type, severity, description, route_to, status, sla_hours",
        "FROM IDENTIFIER(:catalog || '.' || :schema || '.gold_approval_queue')"
      ],
      "parameters": [
        { "name": "catalog", "keyword": "catalog", "defaultSelection": { "values": { "values": [ { "value": "workspace" } ] } } },
        { "name": "schema", "keyword": "schema", "defaultSelection": { "values": { "values": [ { "value": "default" } ] } } }
      ]
    }
  ],
