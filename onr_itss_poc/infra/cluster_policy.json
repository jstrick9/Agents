{
  "name": "onr-itss-nitro-restricted",
  "definition": {
    "aws_attributes.availability": {
      "type": "fixed",
      "value": "ON_DEMAND",
      "hidden": true
    },
    "aws_attributes.zone_id": {
      "type": "unlimited",
      "defaultValue": "auto"
    },
    "node_type_id": {
      "type": "allowlist",
      "values": [
        "m6i.xlarge",
        "m6i.2xlarge",
        "r6i.xlarge",
        "r6i.2xlarge"
      ],
      "defaultValue": "m6i.xlarge"
    },
    "driver_node_type_id": {
      "type": "allowlist",
      "values": [
        "m6i.xlarge",
        "m6i.2xlarge",
        "r6i.xlarge"
      ],
      "defaultValue": "m6i.xlarge"
    },
    "autotermination_minutes": {
      "type": "range",
      "minValue": 10,
      "maxValue": 30,
      "defaultValue": 15
    },
    "data_security_mode": {
      "type": "fixed",
      "value": "USER_ISOLATION",
      "hidden": true
    },
    "spark_conf.spark.databricks.cluster.profile": {
      "type": "forbidden"
    },
    "custom_tags.classification": {
      "type": "fixed",
      "value": "mock-unclassified"
    }
  },
  "description": "Classic fallback for GovCloud/IL5 when serverless is not enabled. Nitro instance families only. No CUI in tags."
}
